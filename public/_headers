# Cabeceras de Workers Static Assets (OpenNext copia public/ a .open-next/assets).
# Sin esto, los estáticos salen con max-age=0 y cada visita repetida revalida cada imagen.
# /_next/static lleva hash en el nombre: inmutable. El resto no: una semana.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/grabados/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/campus/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/logos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/hackuc3m-mark.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
