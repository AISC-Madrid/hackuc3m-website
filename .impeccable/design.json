  "narrative": {
    "northStar": "HackUC3M, precisely expressed",
    "overview": "A precise, restrained dark interface carries HackUC3M’s original plum, rose and cream identity. Thin dividers, generous breathing room and small functional details establish a Linear-like clarity; the Cinzel hero wordmark supplies the distinct brand voice.\n\nMotion is quiet and local: the hero title settles once and a diffuse plum light breathes behind it. The navigation symbol is the supplied cropped mark, without lettering; the rejected floating hero emblem is absent.",
    "keyCharacteristics": [
      "Dark aubergine tonal surfaces with selective brand accents.",
      "Geist for the interface; Cinzel reserved for the hero brand.",
      "Fine borders, calm spacing and smooth interactive states."
    ],
    "rules": [
      {
        "name": "The Single Display Voice Rule",
        "body": "Use Cinzel only for the hero brand; the rest of the interface speaks in Geist.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do preserve the supplied HackUC3M symbol and original brand palette.",
      "Do keep Cinzel confined to the hero brand and use Geist for interface text.",
      "Do retain visible keyboard focus and disable motion for reduced-motion preferences."
    ],
    "donts": [
      "Don’t restore the floating hero emblem or poster treatment.",
      "Don’t turn the restrained interface into a field of decorative cards or accent fills.",
      "Don’t communicate success or errors through color alone."
    ]
  }
